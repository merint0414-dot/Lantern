{
  "manifest_version": 3,
  "name": "LANTERN - Intelligent Web Assistance",
  "version": "1.0.0",
  "description": "LANTERN provides contextual accessibility guidance on websites and public service portals.",

  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],

      "js": [
        "config.js",
        "intentRecognizer.js",
        "adapters/ksrtcAdapter.js",
        "adapters/irctcAdapter.js",
        "adapters/bharatgasAdapter.js",
        "adapters/ksebAdapter.js",
        "content.js"
      ],

      "css": [
        "content.css"
      ],

      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "LANTERN"
  }
}